    <!-- Permission rationale strings -->
    <string name="permission_notification_title">Enable Notifications</string>
    <string name="permission_notification_rationale">SurakshaSathi needs notification permission to alert you immediately when a phishing message or malicious app is detected.</string>
    <string name="permission_notification_listener_title">Enable Notification Access</string>
    <string name="permission_notification_listener_rationale">To scan WhatsApp and Telegram messages for phishing, SurakshaSathi needs Notification Access. This is the only way to read message content — no data is stored without your consent.</string>
    <string name="permission_camera_title">Enable Camera</string>
    <string name="permission_camera_rationale">Camera is used for liveness verification during high-risk transactions and scanning QR codes to verify official Bank links. No images are stored or transmitted.</string>
    <string name="permission_location_title">Enable Location (Optional)</string>
    <string name="permission_location_rationale">Anonymous coarse location helps display the fraud heatmap and show regional threats near you. This is optional.</string>
    <string name="permission_sms_title">Enable SMS Access</string>
    <string name="permission_sms_rationale">SMS scanning requires this permission. By default, SurakshaSathi uses Notification Access instead (no restricted permission needed). This option is for enterprise deployments only.</string>

