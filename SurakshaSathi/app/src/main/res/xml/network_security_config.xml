<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration (used by ALL build types, including debug, except where
    app/src/debug/res/xml/network_security_config.xml overrides this file for debug builds only:
    that debug-only variant additionally permits cleartext to local dev-server addresses. This
    file, and therefore every release build, never permits cleartext anywhere.
    - Blocks all cleartext (HTTP) traffic
    - Enables certificate transparency
    - Certificate pins added in Phase 7 hardening via code (OkHttp CertificatePinner)
-->
<network-security-config>
    <!-- No cleartext traffic allowed anywhere -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust the system CA store -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- debug-overrides only relaxes trust anchors (accept user/dev-installed CAs for MITM
         proxies like Charles/mitmproxy). It does NOT and cannot relax cleartextTrafficPermitted:
         Android's schema doesn't support that inside debug-overrides. This block is ONLY active
         in debug; it is absent in the release-merged manifest. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
