<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules for Android 12+ -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude the encrypted DB — it's tied to this device's Keystore key -->
        <exclude domain="database" path="surakshasathi.db" />
        <exclude domain="database" path="surakshasathi.db-shm" />
        <exclude domain="database" path="surakshasathi.db-wal" />
        <!-- Exclude encrypted preferences -->
        <exclude domain="sharedpref" path="db_key_prefs.xml" />
        <exclude domain="sharedpref" path="surakshasathi_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="surakshasathi.db" />
        <exclude domain="sharedpref" path="db_key_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
