# ── SurakshaSathi local.properties ─────────────────────────────────────────────
# Copy this file to local.properties and fill in values.
# NEVER commit local.properties to VCS — it is in .gitignore.
# This file is safe to commit as a reference template.

# ── Backend ───────────────────────────────────────────────────────────────────
# Base URL for all SurakshaSathi backend API calls (include trailing slash)
BACKEND_BASE_URL=https://api.surakshasathi.bank.example/

# ── Google Maps (Flow 4a: Fraud Heatmap) ─────────────────────────────────────
# Obtain from: https://console.cloud.google.com/
# If empty, the app falls back to a static Compose Canvas heatmap
MAPS_API_KEY=

# ── VirusTotal (Flow 2: APK cloud scan Tier 2) ───────────────────────────────
# Obtain from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# ── Azure Translator (multi-language Learn content) ──────────────────────────
# Obtain from: https://portal.azure.com/ (Cognitive Services -> Translator)
# If empty, translated text transparently falls back to the original English source
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/

# ── SMS Strategy (Flow 1 ingestion) ──────────────────────────────────────────
# NOTIFICATION_ONLY (default, Play-publishable) or DEFAULT_HANDLER (restricted)
SMS_STRATEGY=NOTIFICATION_ONLY

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to true to use offline fake data sources instead of real Retrofit clients
USE_OFFLINE_FALLBACK=false

# ── Release signing (CI: use secrets instead) ────────────────────────────────
# KEYSTORE_PATH=path/to/keystore.jks
# KEYSTORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=
