# --- Blue DB + guidelines vector store (Cloud SQL for PostgreSQL, pgvector extension) ---
# Local/dev: a plain postgresql:// URL. In Cloud Run: use the Cloud SQL Python Connector with
# the instance connection name instead (see db/postgres_client.py) -- no public IP needed.
POSTGRES_DSN=postgresql://user:password@localhost:5432/surakshasathi
PGVECTOR_DIM=96

# --- Hot cache / bloom filter (Memorystore for Redis) ---
REDIS_URL=

# --- LLM ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Reputation / threat intel ---
VIRUSTOTAL_API_KEY=

# --- Language (Google Cloud Translation v2 REST API, key-based auth) ---
GOOGLE_TRANSLATE_API_KEY=
BHASHINI_API_KEY=                    # optional fallback, primary is Google Cloud Translation
ENABLE_BHASHINI_FALLBACK=false

# --- Callback number verification ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- URL reputation ---
WHOISXML_API_KEY=

# --- Per-message low-latency web corroboration ---
TAVILY_API_KEY=

# --- Push notifications ---
# Must be a filesystem path to a Firebase Admin SDK service-account JSON (Firebase Console ->
# Project Settings -> Service Accounts -> Generate new private key). A Google API key is not
# sufficient for server-side FCM sends via firebase-admin.
FIREBASE_CREDENTIALS_PATH=

# --- Feature flags ---
ENABLE_TRUECALLER=false

# --- Latency budgets (ms) ---
WEB_SEARCH_TIMEOUT_MS=1200
URL_HEAD_TIMEOUT_MS=800
